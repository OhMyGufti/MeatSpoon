{
  "expo": {
    "name": "MeatSpoon",
    "slug": "meatspoon-app",
    "scheme": "meatspoon",
    "version": "1.2.2",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meatspoon.app"
    },
    "android": {
      "package": "com.meatspoon.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111827"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DailyScheduleWidget",
              "label": "MeatSpoon - Daily Schedule",
              "description": "Today's Technion classes, pinned tasks & live timeline",
              "minWidth": "110dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FreeTimeWidget",
              "label": "MeatSpoon - Free Time",
              "description": "1x1 Free Time status clock & one-tap spontaneous finder",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad938f54-572c-462d-a1f5-0bae47d7b48f"
      }
    },
    "experiments": {
      "baseUrl": "/MeatSpoon"
    }
  }
}
